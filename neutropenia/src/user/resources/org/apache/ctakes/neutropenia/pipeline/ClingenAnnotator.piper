package org.apache.ctakes.neutropenia

set SetJavaHome=no

load PbjStarter

add PythonRunner Command="-m pip install resources/org/apache/ctakes/neutropenia/neutropenia_py" Wait=yes

set ClinGenSecondStep=neutropenia.clingen_annotator_pipeline

add PythonRunner Command="-m $ClinGenSecondStep -rq JavaToPy -sq PyToJava"

// Tokenization etc
add BsvRegexSectionizer SectionsBsv=org/apache/ctakes/core/sections/NeutropeniaSectionRegex.bsv
add SentenceDetector
//  AnnotatorBIO classifierJarPath=/org/apache/ctakes/core/models/sentdetect/model.jar
// add MrsDrSentenceJoiner
// add ParagraphAnnotator
// add ParagraphSentenceFixer
// add ListAnnotator
// add ListParagraphFixer
// add ListSentenceFixer

add PbjJmsSender SendQueue=JavaToPy SendStop=yes

// Get cas from Artemis.
add PbjReceiverAE ReceiveQueue=PyToJava

add ArtemisStopper

Bootstrap: docker
From: ubuntu:24.04
%help
  Build this with:
  $ apptainer build ctakes-neutropenia-endpoint.sif ctakes-neutropenia-endpoint.def
  Then:
  $ apptainer run ctakes-neutropenia-endpoint.sif  # or ./ctakes-neutropenia-endpoint.sif
%files
  input /app/input
  output /app/output
  neutropenia /app/neutropenia
%labels
  AUTHOR_NAME Eli Goldner
  AUTHOR_EMAIL eli.goldner@childrens.harvard.edu
  VERSION 1.0
%environment
  export LC_ALL='C'
%post -c /bin/bash
  apt-get -y update && apt-get -y upgrade
  apt-get -y install git openjdk-17-jdk maven curl python3.12 python3.12-pip unzip
  ln -fs /usr/bin/python3.12 /usr/bin/python
  python -m pip install -U pip
  cd /app
  unzip apache-artemis-2.51.0-bin.zip && apache-artemis-2.51.0/bin/artemis create mybroker --user deepphe --password deepphe --allow-anonymous

  # cleanup
  apt-get -y autoremove --purge
  apt-get -y clean

  # Install
  cd /app/neutropenia
  mvn -U clean package
%runscript
  exec java -cp /app/neutropenia/target/ctakes-neutropenia-endpoint-7.0.0-SNAPSHOT-jar-with-dependencies.jar \
      org.apache.ctakes.core.pipeline.PiperFileRunner \
      -p org/apache/ctakes/neutropenia/pipeline/ClingenAnnotator \
      -i /app/input \
      -o /app/output \
      -a /app/mybroker -v ./test_venv/bin/python